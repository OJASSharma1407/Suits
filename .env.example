# =================================================================
# SUITS Environment Configuration
# Copy this file to .env before running: docker compose up -d
# =================================================================

# -----------------------------------------------------------------
# Database & Cache (Docker internal service names)
# -----------------------------------------------------------------
POSTGRES_USER=suits
POSTGRES_PASSWORD=suits
POSTGRES_DB=suits
POSTGRES_PORT=5432
REDIS_PORT=6379

# -----------------------------------------------------------------
# Exposed Ports
# -----------------------------------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=8000

# -----------------------------------------------------------------
# Security & JWT Tokens
# Generate random 32-character strings for production!
# -----------------------------------------------------------------
JWT_SECRET=super-secret-jwt-key-replace-with-secure-random-32-chars
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-with-secure-random-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------
# External Court & Legal Intelligence APIs
# -----------------------------------------------------------------
# eCourts Partner API
ECOURTS_API_KEY=
ECOURTS_BASE_URL=https://webapi.ecourtsindia.com

# Indian Kanoon API (api.indiankanoon.org)
KANOON_API_TOKEN=

# -----------------------------------------------------------------
# AI Models & APIs
# -----------------------------------------------------------------
# Google Gemini (Used for Order Summary, Kanoon Case Extraction, and PDF OCR)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PREDICTION_GEMINI_MODEL=gemini-3.5-flash

# OpenRouter (Used for Interactive AI Chatbot)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MAX_TOKENS=2048

# Groq Cloud API (Gemini fallback — llama-3.3-70b-versatile)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama AI (Offline mode — host.docker.internal accesses host machine)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# -----------------------------------------------------------------
# Authentication & Notifications
# -----------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
RESEND_API_KEY=
EMAIL_FROM="Suits Legal <onboarding@resend.dev>"

# -----------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
