# Database
DATABASE_URL=postgresql+asyncpg://suits:suits@localhost:5432/suits

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=super-secret-jwt-key-replace-with-secure-random-32-chars
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-with-secure-random-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# eCourts Partner API
ECOURTS_API_KEY=your-ecourts-api-key
ECOURTS_BASE_URL=https://api.ecourts.gov.in/partner

# Indian Kanoon API
KANOON_API_TOKEN=your-kanoon-api-token

# Gemini AI API (Used for Order Summary, Kanoon Case Extraction, and PDF OCR)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
PREDICTION_GEMINI_MODEL=gemini-3.5-flash

# OpenRouter AI (Used for Interactive AI Chatbot)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MAX_TOKENS=2048

# Groq Cloud API (Gemini fallback — llama-3.3-70b-versatile)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama AI (Offline mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email Verification (Resend API)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="Suits Legal <onboarding@resend.dev>"

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
