# Database
DATABASE_URL=postgresql+asyncpg://suits:suits@localhost:5432/suits

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-this-to-a-random-secret-key
JWT_REFRESH_SECRET=change-this-to-another-random-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# eCourts Partner API
ECOURTS_API_KEY=your-ecourts-api-key
ECOURTS_BASE_URL=https://api.ecourts.gov.in/partner

# Gemini AI API (Used for Order Summary, Kanoon Case Extraction, and PDF OCR)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter AI (Used for Interactive AI Chatbot)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_MAX_TOKENS=2048

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Email Verification (Resend API)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Suits Legal <onboarding@resend.dev>"

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
