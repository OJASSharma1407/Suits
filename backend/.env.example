# Database
DATABASE_URL=postgresql+asyncpg://suits:suits@localhost:5432/suits

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-this-to-a-random-secret-key
JWT_REFRESH_SECRET=change-this-to-another-random-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# eCourts Partner API
ECOURTS_API_KEY=your-ecourts-api-key
ECOURTS_BASE_URL=https://api.ecourts.gov.in/partner

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
